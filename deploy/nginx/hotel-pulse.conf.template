# HotelPulse — HTTPS (sertifikat olingandan keyin).
# StudyGrow serveridagi umumiy nginx'da turadi (/opt/studygrow/nginx/templates/).
# MUHIM: upstream o'zgaruvchi + Docker resolver orqali — hotelpulse-app to'xtab
# qolsa ham nginx ishga tushaveradi (aks holda StudyGrow ham yiqilardi);
# bu holda faqat hotel-pulse.uz 502 qaytaradi.

# 80-port: Let's Encrypt yangilash tekshiruvi + qolgani HTTPS'ga.
server {
    listen 80;
    server_name hotel-pulse.uz www.hotel-pulse.uz;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://hotel-pulse.uz$request_uri;
    }
}

# www → asosiy domen.
server {
    listen 443 ssl;
    http2 on;
    server_name www.hotel-pulse.uz;

    ssl_certificate     /etc/letsencrypt/live/hotel-pulse.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hotel-pulse.uz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://hotel-pulse.uz$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name hotel-pulse.uz;

    ssl_certificate     /etc/letsencrypt/live/hotel-pulse.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hotel-pulse.uz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # HSTS, X-Content-Type-Options, X-Frame-Options va Referrer-Policy'ni
    # ilovaning o'zi (Spring Security) qo'yadi — bu yerda takrorlanmaydi.

    client_max_body_size 10M;

    location / {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $hotelpulse_upstream http://hotelpulse-app:8081;
        proxy_pass $hotelpulse_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
